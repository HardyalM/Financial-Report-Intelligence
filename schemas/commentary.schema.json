{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/schemas/commentary.schema.json",
  "title": "Commentary",
  "description": "Validated commentary (RAG section 4). Every paragraph carries at least one code-verified citation; numbers come from placeholders rendered by code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "label",
    "topics",
    "executive_summary",
    "model",
    "prompt_version",
    "query_set_version",
    "retrieval_set_id",
    "trace_id",
    "statement_pack_sha",
    "ratio_pack_sha",
    "disclaimer"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.1.0"
    },
    "mode": {
      "type": "string",
      "enum": [
        "generated",
        "extractive"
      ]
    },
    "label": {
      "type": [
        "string",
        "null"
      ],
      "description": "Shown with extractive output: 'Extractive summary: no generated text'."
    },
    "topics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/topic"
      }
    },
    "executive_summary": {
      "$ref": "#/$defs/summary"
    },
    "model": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "provider",
        "model_id"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "model_id": {
          "type": "string"
        }
      }
    },
    "prompt_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "query_set_version": {
      "type": "string"
    },
    "retrieval_set_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "statement_pack_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ratio_pack_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "disclaimer": {
      "type": "string",
      "description": "Research aid, not investment advice."
    }
  },
  "$defs": {
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citation_id",
        "chunk_id",
        "quote",
        "match",
        "char_start",
        "char_end",
        "page",
        "page_end",
        "page_label",
        "section",
        "heading_path",
        "note_number",
        "is_footnote",
        "bbox"
      ],
      "properties": {
        "citation_id": {
          "type": "string"
        },
        "chunk_id": {
          "type": "string"
        },
        "quote": {
          "type": "string",
          "description": "As the model wrote it (5-60 words); verified against the chunk text after normalisation."
        },
        "match": {
          "type": "string",
          "enum": [
            "exact",
            "normalised"
          ]
        },
        "char_start": {
          "type": "integer",
          "minimum": 0,
          "description": "Offset of the quote in the document's narrative text (chunk.char_start + offset in the chunk), computed by code."
        },
        "char_end": {
          "type": "integer",
          "minimum": 0
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "description": "1-based PDF page of the quote's first character. Always code-derived."
        },
        "page_end": {
          "type": "integer",
          "minimum": 1
        },
        "page_label": {
          "type": [
            "string",
            "null"
          ],
          "description": "Printed folio when known."
        },
        "section": {
          "type": "string"
        },
        "heading_path": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note_number": {
          "type": [
            "string",
            "null"
          ]
        },
        "is_footnote": {
          "type": "boolean"
        },
        "bbox": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "description": "One [page, x0, y0, x1, y1] per page the quote touches, display-space points."
        }
      }
    },
    "paragraph_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retried",
        "removed_citations"
      ],
      "properties": {
        "retried": {
          "type": "boolean"
        },
        "removed_citations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "chunk_id",
              "reason"
            ],
            "properties": {
              "chunk_id": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template",
        "rendered",
        "citations",
        "figures",
        "validation"
      ],
      "properties": {
        "template": {
          "type": "string",
          "description": "The model's text with {{placeholders}}; numbers appear only as placeholders or inside verified quotation marks."
        },
        "rendered": {
          "type": "string",
          "description": "The template with placeholders replaced by code-rendered values."
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "validation": {
          "$ref": "#/$defs/paragraph_validation"
        },
        "figures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/figure"
          }
        }
      }
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic",
        "status",
        "reason",
        "paragraphs"
      ],
      "properties": {
        "topic": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "insufficient_evidence",
            "validation_failed",
            "omitted"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "paragraphs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/paragraph"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "bullets"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "validation_failed",
            "omitted"
          ]
        },
        "bullets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/paragraph"
          }
        }
      }
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "placeholder",
        "rendered",
        "pages"
      ],
      "description": "A figure a paragraph states through a placeholder, with the printed page(s) it comes from. Computed by code from the packs; the model supplies only the placeholder.",
      "properties": {
        "placeholder": {
          "type": "string"
        },
        "rendered": {
          "type": [
            "string",
            "null"
          ]
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "PDF pages that print the figure, or that print the inputs of a ratio or change."
        }
      }
    }
  }
}
