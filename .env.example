# Copy to .env and fill in locally. Never commit .env.
# Every key is optional: without keys the pipeline runs on local fallbacks (docs/ARCHITECTURE.md section 5.2).

# Premium parser (image-layout engine family)
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=
FININTEL_AZURE_DI_API_VERSION=2024-11-30
FININTEL_AZURE_DI_MODEL=prebuilt-layout

# LLM provider (OQ-9 = A: Anthropic). Model ids are configuration, never code.
ANTHROPIC_API_KEY=
FININTEL_MAPPING_MODEL=claude-opus-5-5
FININTEL_VISION_MODEL=claude-opus-5-5
FININTEL_COMMENTARY_MODEL=claude-sonnet-5

# Embeddings and rerank
VOYAGE_API_KEY=
FININTEL_EMBEDDING_MODEL=voyage-4-large
FININTEL_RERANK_MODEL=rerank-3

# Storage (v1 is local; Supabase is the v1.1 hosted target)
DATABASE_URL=postgresql://finintel:finintel@localhost:5432/finintel
FININTEL_STORAGE_DIR=./artifacts/storage
FININTEL_ARTIFACTS_DIR=./artifacts
FININTEL_CACHE_DIR=./artifacts/cache

# Tracing (optional; falls back to JSONL files under artifacts/traces/)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# v1.1 only, or if OQ-9 = B
REDUCTO_API_KEY=
LLAMA_CLOUD_API_KEY=
GEMINI_API_KEY=

# Logging to stderr: console (key=value) or json. Logs never carry report text or secrets.
FININTEL_LOG_FORMAT=console
FININTEL_LOG_LEVEL=WARNING
